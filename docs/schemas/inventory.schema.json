{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory",
  "description": "The inventory file.",
  "type": "object",
  "properties": {
    "build_scanned_ms": {
      "description": "When the build was last scanned (ms since the epoch).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "default": null,
      "minimum": 0
    },
    "category_rules": {
      "description": "The project's own terms for sorting items into categories; they win over the built-in\nkeywords ([`crate::asset_categories::CategoryRule`]).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CategoryRule"
      }
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "notes": {
      "description": "What the last scan of each source left out or couldn't do, in words.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "original_folder": {
      "description": "The original's folder at that scan.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "original_scanned_ms": {
      "description": "When the original was last scanned.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "default": null,
      "minimum": 0
    },
    "version": {
      "description": "The format version ([`INVENTORY_VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    }
  },
  "$defs": {
    "Category": {
      "description": "What an asset is for in the game.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "enemies",
            "music"
          ]
        },
        {
          "description": "The player and their gear and voice.",
          "type": "string",
          "const": "characters"
        },
        {
          "description": "Weapons and tools.",
          "type": "string",
          "const": "weapons"
        },
        {
          "description": "Items and pickups.",
          "type": "string",
          "const": "items"
        },
        {
          "description": "Machines and props: vehicles, turrets, pods, crates.",
          "type": "string",
          "const": "machines"
        },
        {
          "description": "HUD and menus: icons, buttons, fonts, menu and UI sounds, menu video.",
          "type": "string",
          "const": "hud"
        },
        {
          "description": "Terrain, rocks, caves, sky, ambience.",
          "type": "string",
          "const": "environment"
        },
        {
          "description": "Particles, emitters, trails, impacts.",
          "type": "string",
          "const": "effects"
        },
        {
          "description": "Not sorted yet.",
          "type": "string",
          "const": "unsorted"
        }
      ]
    },
    "CategoryBy": {
      "description": "Who chose an item's category.",
      "oneOf": [
        {
          "description": "The rules (the project's terms, the built-in keywords, the kind); applied again on rescans.",
          "type": "string",
          "const": "rule"
        },
        {
          "description": "An agent (project_inventory_categorize); kept on rescans.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "The person; kept on rescans, and an agent's choice doesn't replace it.",
          "type": "string",
          "const": "user"
        }
      ]
    },
    "CategoryRule": {
      "description": "A project's own term: items whose name, path or origin has it go to `category`. Wins over\nthe built-in keywords.",
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "term": {
          "description": "A word (`glyphid`) or words (`bugs small`), matched like the built-in keywords; any case.",
          "type": "string"
        }
      },
      "required": [
        "term",
        "category"
      ]
    },
    "Item": {
      "description": "One asset.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Its size on disk (or inside the original, when it wasn't taken out).",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "category": {
          "description": "What it is for in the game ([`crate::asset_categories`]).",
          "$ref": "#/$defs/Category",
          "default": "unsorted"
        },
        "category_by": {
          "description": "Who chose the category: the rules, an agent or the person (who wins over an agent).",
          "$ref": "#/$defs/CategoryBy",
          "default": "rule"
        },
        "detail": {
          "description": "What it is in more words (an Unreal package's class, a sound bank's codec, what a generated\nasset was made from).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "duration_secs": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "id": {
          "description": "Stable: a hash of the source and the item's key (`path` for the build, `origin` for the\noriginal), so it survives rescans.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "marked_ms": {
          "description": "When the person last set its status or note (ms since the epoch); a rescan keeps a marked\nitem's status and note.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "name": {
          "description": "What it's called (the file's name, or the asset's name inside the original).",
          "type": "string"
        },
        "note": {
          "description": "The person's note.",
          "type": "string",
          "default": ""
        },
        "origin": {
          "description": "For the original: where it is in the original, relative to the original's folder\n(`<archive>[:<file inside>]#<object id>`, or a loose file's path).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "path": {
          "description": "The file, relative to the project folder (`/`-separated). None for an item of the original\nthat wasn't taken out (`problem` or `detail` says why).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "problem": {
          "description": "What went wrong reading or taking it out, when something did.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "rebuild": {
          "description": "The rebuild it was sent to (project_inventory_rebuild), while it waits to be replaced.",
          "anyOf": [
            {
              "$ref": "#/$defs/RebuildMark"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "thumb": {
          "description": "A picture of it at most 256 pixels on a side (a PNG under reference/thumbs/), relative to\nthe project folder.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "source",
        "kind",
        "name",
        "status"
      ]
    },
    "Kind": {
      "description": "What an item is.",
      "type": "string",
      "enum": [
        "texture",
        "sprite",
        "model",
        "sound",
        "music",
        "font",
        "video",
        "map",
        "material",
        "engine_asset",
        "other"
      ]
    },
    "RebuildMark": {
      "description": "An item's place in a rebuild: how it's to be remade, when it was asked for, and the rebuild's\nlist (`rebuild/<category>-<time>.json`, by its file name without `.json`).",
      "type": "object",
      "properties": {
        "job": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "requested_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "method",
        "requested_ms",
        "job"
      ]
    },
    "Source": {
      "description": "Where an item is.",
      "oneOf": [
        {
          "description": "A file of the build (app/).",
          "type": "string",
          "const": "build"
        },
        {
          "description": "Taken out of the original (Deep mode only), into reference/assets/.",
          "type": "string",
          "const": "original"
        }
      ]
    },
    "Status": {
      "description": "Where an item stands, for the person.",
      "oneOf": [
        {
          "description": "The original's own asset.",
          "type": "string",
          "const": "original"
        },
        {
          "description": "Made by an asset generator (listed in assets.json).",
          "type": "string",
          "const": "generated"
        },
        {
          "description": "From a library or pack (a marketplace or starter pack, an engine's own content).",
          "type": "string",
          "const": "library"
        },
        {
          "description": "A stand-in the builder made or took; the starting status of the build's files.",
          "type": "string",
          "const": "placeholder"
        },
        {
          "description": "The person wants it replaced.",
          "type": "string",
          "const": "needs_replacing"
        },
        {
          "description": "The person replaced it.",
          "type": "string",
          "const": "replaced"
        }
      ]
    }
  }
}
